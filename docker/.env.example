# Kopieren nach .env im Ordner docker/
# cp .env.example .env

# --- Allgemein ---
COMPOSE_PROJECT_NAME=rag

# --- Backend (documentApi) ---
API_PORT=8000
RAG_DATA_ROOT=/data
LLM_BASE_URL=http://ollama:11434/v1
# Bei externem LLM (z. B. OpenAI): LLM_BASE_URL=https://api.openai.com/v1

# Postgres (wenn Profil postgres aktiv)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Qdrant Server-Modus (wenn Profil qdrant aktiv; alternativ qdrant_embedded im API-Volume)
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Ollama (gemeinsamer Service)
OLLAMA_PORT=11434

# Web-Chat (qa_site)
CHAT_WEB_PORT=8080
# Im Browser muss die API erreichbar sein — Standard fuer Host-Zugriff:
CHAT_DEFAULT_API_URL=http://localhost:8000
# Optional: vorausgefuellter Client-Key im Web-Chat (muss mit RAG_DEFAULT_API_KEY uebereinstimmen)
CHAT_DEFAULT_API_KEY=

# Admin-Web (Document Handling UI)
ADMIN_WEB_PORT=8081

# --- API-Authentifizierung (documentApi) ---
# Beim ersten Start ohne bestehende Keys werden Client- und Admin-Key erzeugt (Logs).
# Feste Keys fuer reproduzierbare Deployments:
RAG_DEFAULT_API_KEY=
RAG_ADMIN_API_KEY=
