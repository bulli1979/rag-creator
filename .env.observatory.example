# Copy this file to .env before running docker compose.

# Used for naming containers (example: observatory-postgres)
COMPOSE_PROJECT_NAME=observatory

# Host ports
API_PORT=8000
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# Postgres settings
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=public
POSTGRES_TABLE=rag_documents

# Directory containing the Markdown corpus mounted read-only into document-api.
NOTBOT_DOCUMENTS_DIR=../NOTBot-documents/data/processed
